# Mapbox public access token only. Never put a Mapbox SECRET token in a VITE_*
# variable — Vite inlines these into the browser bundle where anyone can read them.
VITE_MAPBOX_ACCESS_TOKEN=your_access_token_here

VITE_LOCATIONIQ_TOKEN=your_locationiq_token_here

# Backend URL
VITE_API_BASE=https://api.truthnuke.tech
